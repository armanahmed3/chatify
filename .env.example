# ==============================================================================
# CHATIFY AI CHATBOT PLATFORM — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth, Storage & pgvector)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Central Lifetime-Free AI Router Engines
# ------------------------------------------------------------------------------
# Tier 1: Google Gemini (Free via Google AI Studio)
GEMINI_API_KEY=your-gemini-ai-studio-key

# Tier 2 & 3: Groq (Free llama-3.1-8b-instant & gpt-oss-120b / llama-3.3-70b)
GROQ_API_KEY=your-groq-api-key

# Tier 4: Cloudflare Workers AI (Free daily neurons for LLM + Embeddings)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Tier 5: OpenRouter (Free tier models)
OPENROUTER_API_KEY=your-openrouter-key

# Tier 6: Last Resort Paid Fallback (Only used if all free tiers fail)
PAID_FALLBACK_ENABLED=false

# ------------------------------------------------------------------------------
# 3. Upstash Redis (Semantic Cache & Token-Bucket Rate Limiter)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# ------------------------------------------------------------------------------
# 4. Stripe (Billing & Flat-Subscription Management)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_starter_monthly
STRIPE_PRO_PRICE_ID=price_pro_monthly
STRIPE_AGENCY_PRICE_ID=price_agency_monthly

# ------------------------------------------------------------------------------
# 5. Resend (Instant Lead Notifications & Weekly ROI Reports)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_...
# Must be an address on a domain you verified in Resend (onboarding@resend.dev only delivers to your own inbox)
RESEND_FROM_EMAIL=notifications@yourdomain.com
# Where hot-lead alerts are sent (no alert is sent if unset)
OWNER_ALERT_EMAIL=owner@yourdomain.com

# ------------------------------------------------------------------------------
# 6. Meta Developer Platform (WhatsApp Cloud API & Messenger/IG Webhooks)
# ------------------------------------------------------------------------------
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# REQUIRED for the webhook to work. Generate with: openssl rand -hex 32
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-system-user-token

# ------------------------------------------------------------------------------
# 7. Application & Deployment
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WIDGET_URL=http://localhost:3000/widget.js
# Extra trusted browser origins for CSRF checks (comma separated), e.g. https://app.yourdomain.com
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 8. Security toggles
# ------------------------------------------------------------------------------
# Require SMS phone verification at signup (only enable once an SMS provider is wired up)
SMS_VERIFICATION_ENABLED=false

# LOCAL DEVELOPMENT ONLY — passwords for the in-memory sandbox accounts (ignored in production)
DEV_ADMIN_PASSWORD=
DEV_USER_PASSWORD=
